# ============================================================
# EDW Security — Veza OAA Integration
# Environment configuration template
#
# Copy this file to .env and fill in real values:
#   cp .env.example .env
#   chmod 600 .env
#
# NEVER commit the .env file to source control.
# ============================================================

# ------------------------------------------------------------
# Oracle Database — EDW source
# ------------------------------------------------------------
# Hostname of the Oracle database server
EDW_DB_HOST=your-oracle-db-host.example.com

# Oracle listener port (typically 1521 or 1526)
EDW_DB_PORT=1526

# Oracle SID (System Identifier) for the target database
EDW_DB_SERVICE=your_oracle_sid

# Service account username with SELECT access on Dwt_web_app_access_control
EDW_DB_USER=your_db_service_account

# Service account password
EDW_DB_PASSWORD=your_db_password

# WEB_APP_ID value to query (filter on Dwt_web_app_access_control)
EDW_WEB_APP_ID=100005

# ------------------------------------------------------------
# Veza configuration
# ------------------------------------------------------------
# Your Veza tenant URL (no trailing slash)
# Example: https://your-tenant.veza.com
VEZA_URL=https://your-tenant.veza.com

# Veza API key with OAA write permissions
VEZA_API_KEY=your_veza_api_key_here

# ------------------------------------------------------------
# OAA provider settings (optional — change only if needed)
# ------------------------------------------------------------
# These default to "EDW Security" if not set
# PROVIDER_NAME=EDW Security
# DATASOURCE_NAME=EDW Security
